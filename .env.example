# Скопируй в .env и поменяй секреты: cp .env.example .env
# Эти настройки читают и сайт (app), и игровой сервер (game-server), и миграции.

# База Postgres. Для разработки её поднимает `npm run db:up` (docker-compose.dev.yml).
DATABASE_URL=postgres://fishing:fishing@localhost:5432/fishing

# Redis связывает несколько процессов игрового сервера. Пусто — один процесс, без Redis.
REDIS_URL=

# Ключ шифрования cookie входа — не короче 32 символов. Сгенерировать: openssl rand -hex 32
NUXT_SESSION_PASSWORD=change-me-session-password-at-least-32-chars

# Общий секрет сайта и игрового сервера: им подписываются билеты в игру. Не короче 32 символов.
GAME_SECRET=change-me-game-secret-at-least-32-chars-long

# Где браузер найдёт игровой сервер. В продакшене за Caddy — /game.
NUXT_PUBLIC_GAME_URL=http://localhost:2567

# Порт игрового сервера и адрес, по которому до этого процесса достучится браузер (нужен, когда процессов несколько).
GAME_PORT=2567
PUBLIC_ADDRESS=

# Перевод часов причала из игры (нажать на часы) — время меняется у всех игроков. Инструмент разработки:
# по умолчанию включён везде, кроме продакшена (NODE_ENV=production). 1 — включить явно, 0 — выключить.
# DEV_CLOCK=1

# ---------- Продакшен (docker compose up -d --build) ----------
# Домен сайта: Caddy сам получит для него сертификат. Для проверки у себя — localhost.
DOMAIN=localhost
# Пароль базы внутри docker compose (там DATABASE_URL собирается из него сам).
POSTGRES_PASSWORD=change-me-db-password
