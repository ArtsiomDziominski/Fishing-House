{
  "name": "@fh/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Общий код клиента и серверов: карта, рыбы, правила рыбалки, протокол; server/ — база и билеты входа",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "migrate": "tsx --env-file-if-exists=../.env src/server/migrate.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
